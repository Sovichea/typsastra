<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows shell integration for Typsastra.

  Referenced from tauri.conf.json (bundle.windows.wix). It registers:
    - .typ and .md as Typsastra source documents, with Typsastra as the
      default HKCR handler.
    - "Open with Typsastra" for a folder and for a folder's empty background.

  INSTALLDIR and the Typsastra.exe file name match the WiX template Tauri
  generates (see src-tauri/target/release/wix/<arch>/main.wxs). Windows still
  honors a per-user "Open with" choice, so an existing UserChoice for .typ or
  .md keeps that handler until the user changes it.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <Fragment>
        <ComponentGroup Id="TypsastraShellIntegration">
            <Component Id="TypsastraTypstAssociation" Directory="INSTALLDIR" Guid="*">
                <RegistryKey Root="HKCR" Key=".typ">
                    <RegistryValue Type="string" Value="Typsastra.TypstSource" KeyPath="yes" />
                </RegistryKey>
                <RegistryKey Root="HKCR" Key="Typsastra.TypstSource">
                    <RegistryValue Type="string" Value="Typst Document" />
                    <RegistryValue Name="FriendlyTypeName" Type="string" Value="Typst Document" />
                </RegistryKey>
                <RegistryKey Root="HKCR" Key="Typsastra.TypstSource\DefaultIcon">
                    <RegistryValue Type="string" Value="[INSTALLDIR]Typsastra.exe,0" />
                </RegistryKey>
                <RegistryKey Root="HKCR" Key="Typsastra.TypstSource\shell\open\command">
                    <RegistryValue Type="string" Value="&quot;[INSTALLDIR]Typsastra.exe&quot; &quot;%1&quot;" />
                </RegistryKey>
            </Component>

            <Component Id="TypsastraMarkdownAssociation" Directory="INSTALLDIR" Guid="*">
                <RegistryKey Root="HKCR" Key=".md">
                    <RegistryValue Type="string" Value="Typsastra.Markdown" KeyPath="yes" />
                </RegistryKey>
                <RegistryKey Root="HKCR" Key="Typsastra.Markdown">
                    <RegistryValue Type="string" Value="Markdown Document" />
                    <RegistryValue Name="FriendlyTypeName" Type="string" Value="Markdown Document" />
                </RegistryKey>
                <RegistryKey Root="HKCR" Key="Typsastra.Markdown\DefaultIcon">
                    <RegistryValue Type="string" Value="[INSTALLDIR]Typsastra.exe,0" />
                </RegistryKey>
                <RegistryKey Root="HKCR" Key="Typsastra.Markdown\shell\open\command">
                    <RegistryValue Type="string" Value="&quot;[INSTALLDIR]Typsastra.exe&quot; &quot;%1&quot;" />
                </RegistryKey>
            </Component>

            <Component Id="TypsastraFolderContextMenu" Directory="INSTALLDIR" Guid="*">
                <RegistryKey Root="HKCR" Key="Directory\shell\Typsastra">
                    <RegistryValue Type="string" Value="Open with Typsastra" KeyPath="yes" />
                    <RegistryValue Name="Icon" Type="string" Value="[INSTALLDIR]Typsastra.exe,0" />
                </RegistryKey>
                <RegistryKey Root="HKCR" Key="Directory\shell\Typsastra\command">
                    <RegistryValue Type="string" Value="&quot;[INSTALLDIR]Typsastra.exe&quot; &quot;%1&quot;" />
                </RegistryKey>
                <RegistryKey Root="HKCR" Key="Directory\Background\shell\Typsastra">
                    <RegistryValue Type="string" Value="Open with Typsastra" />
                    <RegistryValue Name="Icon" Type="string" Value="[INSTALLDIR]Typsastra.exe,0" />
                </RegistryKey>
                <RegistryKey Root="HKCR" Key="Directory\Background\shell\Typsastra\command">
                    <RegistryValue Type="string" Value="&quot;[INSTALLDIR]Typsastra.exe&quot; &quot;%V&quot;" />
                </RegistryKey>
            </Component>
        </ComponentGroup>
    </Fragment>
</Wix>
