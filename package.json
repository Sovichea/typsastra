{
  "name": "typsastra",
  "private": true,
  "version": "0.8.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "bun test",
    "test:khmer": "bun test tests/khmerReference.test.ts tests/grapheme.test.ts tests/editingPolicies.test.ts tests/autocomplete.test.ts tests/spellcheck.test.ts",
    "test:lao": "bun test tests/laoReference.test.ts tests/khmerReference.test.ts tests/editingPolicies.test.ts tests/languageSupport.test.ts",
    "test:docs": "bun test tests/documentationLinks.test.ts",
    "conform": "bun test tests/editingPolicies.test.ts tests/khmerReference.test.ts tests/laoReference.test.ts tests/languageSupport.test.ts",
    "benchmark:performance": "bun scripts/run-performance-benchmarks.ts",
    "validate:enhanced-unicode": "bun scripts/run-enhanced-unicode-validation.ts",
    "validate:pdfium-unicode": "bun scripts/run-pdfium-unicode-validation.ts",
    "release:enhanced-unicode:manifest": "bun scripts/enhanced-unicode-release-manifest.ts",
    "validate:examples": "bun scripts/validate-examples.ts",
    "tauri:dev": "bun scripts/run-tauri-with-fallback.ts dev --config src-tauri/tauri.dev.conf.json",
    "tauri:build": "bun scripts/run-tauri-with-fallback.ts build",
    "dev:update": "bun run tauri:dev:update",
    "tauri:dev:update": "tauri dev --config src-tauri/tauri.dev.conf.json --config src-tauri/tauri.update-test.conf.json",
    "tauri:dev:macos-titlebar": "tauri dev --config src-tauri/tauri.dev.conf.json --config src-tauri/tauri.macos-layout-test.conf.json",
    "tauri:dev:pdf-full": "bun scripts/run-pdf-transport-experiment.ts full",
    "tauri:dev:pdf-range": "bun scripts/run-pdf-transport-experiment.ts range",
    "tauri:release:pdf-full": "bun scripts/run-pdf-transport-experiment.ts full release",
    "tauri:release:pdf-range": "bun scripts/run-pdf-transport-experiment.ts range release",
    "generate:typst-parser": "lezer-generator src/editor/typst.grammar -o src/editor/typstParser.ts",
    "benchmark:typst-lezer": "bun scripts/benchmark-typst-lezer.ts"
  },
  "dependencies": {
    "@babel/runtime": "^8.0.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.6.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.10.0",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.4.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.27.0",
    "@lezer/common": "^1.2.3",
    "@lezer/highlight": "^1.2.1",
    "@lezer/lr": "^1.4.2",
    "@replit/codemirror-indentation-markers": "^6.5.3",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@uiw/codemirror-themes": "^4.25.10",
    "@uiw/codemirror-themes-all": "^4.25.10",
    "dompurify": "^3.4.13",
    "lucide": "^1.0.0",
    "marked": "^18.0.9",
    "pdfjs-dist": "6.2.108",
    "tinymist": "^0.12.16"
  },
  "devDependencies": {
    "@lezer/generator": "^1.8.0",
    "@tauri-apps/cli": "^2.0.0",
    "bun-types": "^1.1.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0"
  },
  "patchedDependencies": {
    "pdfjs-dist@6.2.108": "patches/pdfjs-dist@6.2.108.patch"
  }
}
