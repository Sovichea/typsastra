# Maintainer: Typsastra contributors <https://github.com/Sovichea/typsastra/issues>
pkgname=typsastra-bin
pkgver=0.10.0
pkgrel=1
pkgdesc="Typst editor with live preview, autocomplete, outline, diagnostics, and project navigation"
arch=('x86_64' 'aarch64')
url="https://github.com/Sovichea/typsastra"
license=('MIT')
depends=('gtk3' 'webkit2gtk-4.1' 'xdg-utils')
provides=('typsastra')
conflicts=('typsastra')
options=('!strip' '!debug')
source_x86_64=('https://github.com/Sovichea/typsastra/releases/download/v0.10.0/Typsastra_0.10.0_amd64.deb')
source_aarch64=('https://github.com/Sovichea/typsastra/releases/download/v0.10.0/Typsastra_0.10.0_arm64.deb')
noextract=("Typsastra_0.10.0_amd64.deb" "Typsastra_0.10.0_arm64.deb")
sha256sums_x86_64=('3e21d16188fe39ca3cf484b33910337c9b4e5a56a703f665cd2616edbfe5dbc8')
sha256sums_aarch64=('59e65b0cf9f0cfcb176add2211627e1fcc6f5d78e9412ab78f77e7c043311b3b')

package() {
  local deb
  case "$CARCH" in
    x86_64) deb="Typsastra_0.10.0_amd64.deb" ;;
    aarch64) deb="Typsastra_0.10.0_arm64.deb" ;;
    *) error "Unsupported architecture: $CARCH" ;;
  esac

  # The Debian package is a thin wrapper around the same Tauri bundle. Extract
  # its data archive instead of depending on dpkg on Arch Linux.
  bsdtar -xOf "$srcdir/$deb" data.tar.* | bsdtar -xf - -C "$pkgdir"
}
